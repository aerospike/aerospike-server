#!/usr/bin/env bash
#
# Unified version/build-number script. All three outputs are available:
#
# Usage:
#   build/version              -> master/hotfix: w.x.y.z-n; dev branches: git describe with SHA
#   build/version -v           -> master/hotfix: w.x.y.z (bare);
#                                 dev branches: git describe with SHA (same as default)
#   build/version -r           -> master/hotfix: build number n; dev branches: 1
#
# Resolution rules (called by build/gen_version and both deploy workflows):
# - Always anchors on the bare (dev-began) x.y.z.w tag via
#   --match '[0-9]*.[0-9]*.[0-9]*.[0-9]*'; never falls back to an unrestricted
#   describe, which can select the vx.y.z.w *ship* tag and emit a leading-v
#   string the Debian Version: field rejects ("does not start with digit").
# - master/hotfix: strip the describe --long suffix to w.x.y.z; default appends -n.
# - Dev branches: keep the full describe output (-<n>-g<sha>); build number is 1.
# - Falls back to the short SHA when no bare tag is reachable (never v…).
#
# build_number counts first-parent commits after the bare x.y.z.w next-release
# marker tag when one exists on the branch (the tag on the empty commit after a
# "both" tag-release run). Falls back to v[0-9]* if no bare tag exists yet.
# Non-master/non-hotfix branches always return 1.
#
# See build/README-VERSIONING.md.

mode=full # full (default): w.x.y.z-n; version_only: w.x.y.z; build_only: n
while [[ $# -gt 0 ]]; do
    case "$1" in
    -v) mode=version_only ;;
    -r) mode=build_only ;;
    *)
        echo "Usage: $(basename "$0") [-v|-r]" >&2
        exit 1
        ;;
    esac
    shift
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ---------------------------------------------------------------------------
# Build-number calculation
# ---------------------------------------------------------------------------
_build_number() {
    local bn_branch="$1"

    if [[ "$bn_branch" != "master" && ! "$bn_branch" =~ ^hotfix/ ]]; then
        echo "1"
        return
    fi

    local base_tag
    base_tag=$(git describe --first-parent --tags --abbrev=0 \
        --match '[0-9]*.[0-9]*.[0-9]*.[0-9]*' 2>/dev/null) || true
    if [[ -z "$base_tag" ]]; then
        base_tag=$(git describe --first-parent --tags --abbrev=0 \
            --match 'v[0-9]*.[0-9]*.[0-9]*.[0-9]*' 2>/dev/null) || true
    fi

    if [[ -n "$base_tag" ]]; then
        git rev-list --first-parent --count "${base_tag}..HEAD"
    else
        echo "1"
    fi
}

# ---------------------------------------------------------------------------
# Determine branch
# ---------------------------------------------------------------------------
is_release_line=false

if [[ -f /work/VERSION ]]; then
    # CI environment: read pre-computed version and derive branch from event payload.
    rev="$(cat /work/VERSION)"
    if [[ -f /work/EVENT ]]; then
        REF="$(grep -o '"ref":"[^"]*"' /work/EVENT 2>/dev/null | head -1 | cut -d'"' -f4)"
        if [[ "$REF" == "refs/heads/master" || "$REF" =~ refs/heads/hotfix/ ]]; then
            is_release_line=true
        fi
    fi
    if [[ "$is_release_line" == true ]]; then
        rev="$(echo "$rev" | sed 's/-[0-9]*-g[0-9a-f]*$//')"
        branch="master" # placeholder; only used for _build_number below
    else
        branch=""
    fi

    case "$mode" in
    version_only) echo "$rev" ;;
    build_only) _build_number "${branch:-}" ;;
    full)
        if [[ "$is_release_line" == true ]]; then
            echo "${rev}-$(_build_number "${branch:-}")"
        else
            echo "$rev"
        fi
        ;;
    esac
    exit 0
fi

# ---------------------------------------------------------------------------
# Git-describe path (local / standard CI without /work/VERSION)
# ---------------------------------------------------------------------------
branch="$(git branch --show-current)"

if [[ -z "$branch" ]]; then
    branch="$(git branch -r --contains HEAD | grep -v HEAD | head -1 |
        sed -e 's/origin\///' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
fi

if [[ "$branch" == "master" || "$branch" =~ ^hotfix/ ]]; then
    is_release_line=true
fi

if [[ "$mode" == "build_only" ]]; then # -r
    _build_number "$branch"
    exit 0
fi

# Anchor on the bare x.y.z.w tag only (never the vx.y.z.w ship tag).
if [[ "$is_release_line" == true ]]; then
    rev="$(git describe --first-parent --tags --always --abbrev=9 --long \
        --match '[0-9]*.[0-9]*.[0-9]*.[0-9]*' 2>/dev/null |
        sed 's/-[0-9]*-g[0-9a-f]*$//')"
    if [[ -z "$rev" ]]; then
        rev="$(git rev-parse --short=9 HEAD)"
    fi
    case "$mode" in
    version_only) echo "$rev" ;;
    full) echo "${rev}-$(_build_number "$branch")" ;;
    esac
else
    rev="$(git describe --first-parent --tags --always --abbrev=9 --long \
        --match '[0-9]*.[0-9]*.[0-9]*.[0-9]*' 2>/dev/null)"
    if [[ -z "$rev" ]]; then
        rev="$(git rev-parse --short=9 HEAD)"
    fi
    echo "$rev"
fi
