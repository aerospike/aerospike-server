[Unit]
Description=Aerospike Server
After=network-online.target
Wants=network.target

[Service]
LimitNOFILE=100000
TimeoutSec=600
User=root
Group=root
EnvironmentFile=/etc/sysconfig/aerospike
PermissionsStartOnly=True
# ASD_COLDSTART is deliberately separate from ASD_OPTIONS: asd-coldstart sets it
# via an Environment= drop-in, and EnvironmentFile= (above) overrides Environment=,
# so carrying --cold-start in ASD_OPTIONS would silently drop it.
ExecStart=/usr/bin/asd $ASD_OPTIONS $ASD_COLDSTART --config-file $ASD_CONFIG_FILE --fgdaemon

[Install]
WantedBy=multi-user.target
